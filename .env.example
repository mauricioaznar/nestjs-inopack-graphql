NODE_ENV=dev
MYSQL_URL=mysql://root:root@localhost:3306/inopack?pool_timeout=40

# JWT secrets. Optional outside production (the code falls back to a development
# value); REQUIRED in production — the app refuses to boot without them.
# Generate each one with: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_FILE_SECRET=dev-file-secret-change-me

# --- Session lifetimes (Phase 1: refresh tokens) ---------------------------
# Access-token lifetime. Short on purpose: a JWT cannot be revoked, so expiry is
# the only revocation there is. The user does not notice — the refresh cookie
# renews it silently. Any `ms` string ("15m", "900s").
JWT_ACCESS_TTL=15m
# How long a session survives without re-entering a password.
REFRESH_TTL_DAYS=14
# Window in which re-presenting an already-rotated refresh token counts as two
# browser tabs racing rather than as token theft. 0 disables the grace (and is
# what .env.test uses so the theft path can be asserted exactly).
REFRESH_REUSE_GRACE_SECONDS=30

# --- Browser-facing configuration ------------------------------------------
# Comma-separated allowlist of frontend origins. REQUIRED in production: the
# refresh cookie needs credentialed CORS, which forbids the old `*` wildcard, so
# an origin that is not listed here cannot use the API from a browser.
CORS_ORIGINS=http://localhost:3000
# lax | strict | none. Leave unset: defaults to `lax` outside production and
# `none` in production, because the deployed app (Netlify) and the API
# (*.mauaznar.com) are different registrable domains, i.e. cross-site. Only set
# it explicitly if the frontend moves onto an API-adjacent domain, where `lax`
# becomes possible and is stronger.
# AUTH_COOKIE_SAMESITE=none

# Production values — create /root/inopack.env on the server with these:
# NODE_ENV=production
# MYSQL_URL=mysql://root:YOUR_MYSQL_PASSWORD@127.0.0.1:3306/inopack?pool_timeout=40
# JWT_ACCESS_SECRET=<openssl rand -base64 48>
# JWT_FILE_SECRET=<openssl rand -base64 48>
# CORS_ORIGINS=https://<the Netlify frontend origin for this tier>
