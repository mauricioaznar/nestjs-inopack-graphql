NODE_ENV=test
# connection_limit must be >= 2. The Phase 1.6 rotation-race tests
# (auth.service.test.ts) are genuinely concurrent: the outer rotation holds a
# transaction open on one connection while a competing rotation/logout needs a
# SECOND connection to reach its own `lockFamily`, and `the family lock blocks a
# second transaction` spins a contender transaction for the same reason. With a
# pool of 1 the competitor can never get a connection, so it deadlocks until the
# outer transaction times out — the tests hang instead of racing. 5 leaves
# headroom without risking the local MySQL connection cap.
MYSQL_URL=mysql://root:root@localhost:3306/inopack_graphql_test?pool_timeout=40&connection_limit=5
JWT_ACCESS_SECRET=test-access-secret
JWT_FILE_SECRET=test-file-secret
# Phase 3: explicit so the interstitial-token signing in the MFA / password-change
# tests does not depend on the dev fallback. No MAIL_HOST is set, so mail uses the
# console transport (NODE_ENV=test is not production) — the tests spy on
# MailService to read the code rather than parsing stdout.
MFA_TOKEN_SECRET=test-mfa-secret
# No grace period in tests: re-presenting a rotated refresh token must be
# treated as theft immediately, so the family-revocation test asserts the real
# rule instead of racing the clock.
REFRESH_REUSE_GRACE_SECONDS=0
# The auth suite logs in and out constantly. At `log` those lines bury the
# actual test failures; `warn` keeps the output readable while still showing
# anything the suite should not be provoking. (This is also the default for
# NODE_ENV=test — set explicitly so the suite does not depend on that default.)
LOG_LEVEL=warn
