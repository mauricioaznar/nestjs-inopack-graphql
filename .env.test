NODE_ENV=test
MYSQL_URL=mysql://root:root@localhost:3306/inopack_graphql_test?pool_timeout=40&connection_limit=1
JWT_ACCESS_SECRET=test-access-secret
JWT_FILE_SECRET=test-file-secret
# No grace period in tests: re-presenting a rotated refresh token must be
# treated as theft immediately, so the family-revocation test asserts the real
# rule instead of racing the clock.
REFRESH_REUSE_GRACE_SECONDS=0
